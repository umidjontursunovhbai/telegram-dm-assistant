# Copy to .env and fill in locally. Never commit credentials or Telethon session files.
TG_API_ID=
TG_API_HASH=
DM_ALLOWED_USER_IDS=
# Explicitly opt in to every incoming human DM (not groups or bots).
DM_ALLOW_ALL=false
DM_SEND_ENABLED=false
# Opt-in per account only; history subsets are sent to the configured AI provider.
DM_CONTEXT_ENABLED=false
# Authorized first-person owner voice; requires context. Keep per-account, not shared.
DM_REPLY_AS_OWNER=false
# Exclude other managed account IDs to prevent assistant-to-assistant reply loops.
DM_EXCLUDED_USER_IDS=
DM_DATA_DIR=data
LLM_BACKEND=openrouter
LLM_API_KEY=
LLM_MODEL=
# Optional. Defaults to HTTPS endpoint for the chosen backend.
# LLM_BASE_URL=https://openrouter.ai/api/v1
